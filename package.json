{
  "name": "floaty",
  "private": true,
  "version": "0.2.3",
  "description": "Your Windows desktop, but the icons float.",
  "license": "MIT",
  "author": "erictan2001",
  "homepage": "https://github.com/erictan2001/floaty",
  "repository": {
    "type": "git",
    "url": "https://github.com/erictan2001/floaty.git"
  },
  "bugs": {
    "url": "https://github.com/erictan2001/floaty/issues"
  },
  "keywords": [
    "desktop",
    "windows",
    "tauri",
    "widgets",
    "live2d",
    "physics",
    "productivity"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-plugins.mjs && node scripts/check-examples.mjs && tsc --noEmit && vite build",
    "format:check": "prettier --check \"src/**/*.{ts,css,html}\" \"scripts/**/*.mjs\" \"verify/**/*.mjs\"",
    "format:write": "prettier --write \"src/**/*.{ts,css,html}\" \"scripts/**/*.mjs\" \"verify/**/*.mjs\"",
    "check:plugins": "node scripts/check-plugins.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "verify:panes": "node verify/panes.mjs",
    "verify:app": "node verify/app.mjs",
    "verify:app-ready": "node verify/app-ready.mjs",
    "verify:palette": "node verify/palette.mjs",
    "verify:drag": "node verify/drag.mjs",
    "verify:presence": "node verify/presence.mjs",
    "verify:redo": "node verify/redo.mjs",
    "verify:stranded": "node verify/stranded.mjs",
    "verify:arrangement": "node verify/arrangement.mjs",
    "verify:image-thumbnail": "node verify/image-thumbnail.mjs",
    "verify:updater": "node scripts/verify-updater-feed.mjs --artifacts",
    "verify:panel-drag": "node verify/panel-drag.mjs",
    "verify:trail-page": "node verify/trail-page.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "sync:version": "node scripts/sync-main-version.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2",
    "prettier": "^3.9.9",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@pixi/unsafe-eval": "^6.5.10",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10"
  }
}
