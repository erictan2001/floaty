{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Floaty",
  "version": "0.1.1",
  "identifier": "com.floaty.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "manager",
        "url": "index.html#/manager",
        "title": "Floaty",
        "width": 1,
        "height": 1,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost; script-src 'self' 'unsafe-eval' 'unsafe-inline' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/erictan2001/floaty/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVEMzREREEzMjkzMzY4QUIKUldTcmFETXBvOTAwWFNMVVBKdGNNazdkUlYrTzNVZytaVTBvZXlaRjNZV3RUb1N0OFhmcGdCRGgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
