{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Floaty",
  "version": "0.1.0",
  "identifier": "com.floaty.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "manager",
        "url": "index.html#/manager",
        "title": "Floaty",
        "width": 1,
        "height": 1,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
